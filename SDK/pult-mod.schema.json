{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pult Mod SDK 2",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "version",
    "author",
    "permissions",
    "commands"
  ],
  "properties": {
    "format": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "shell",
          "network",
          "chats.read",
          "chats.write",
          "files.read",
          "files.write",
          "team.read",
          "team.write",
          "process",
          "secrets",
          "background"
        ]
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "name",
          "title"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "shell": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "shortcut": {
            "type": "string",
            "maxLength": 40
          }
        },
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "shell"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "shell"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "script"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "script"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "shell"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "panels": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "html"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "html": {
            "type": "string"
          },
          "placement": {
            "enum": [
              "main",
              "left",
              "right",
              "sheet"
            ]
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "title",
        "html"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "html": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "accent"
      ],
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "settings": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 10000
      }
    },
    "background": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "maxProperties": 60,
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkDomains": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(\\*\\.)?[A-Za-z0-9][A-Za-z0-9.-]*$"
      }
    },
    "sidebar": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "panel": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "required": [
                "panel"
              ]
            }
          },
          {
            "required": [
              "panel"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    },
    "toolbar": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "panel": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "required": [
                "panel"
              ]
            }
          },
          {
            "required": [
              "panel"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    },
    "statusbar": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "panel": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "required": [
                "panel"
              ]
            }
          },
          {
            "required": [
              "panel"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "items": {
              "enum": [
                "shell",
                "network"
              ]
            }
          },
          "commands": {
            "items": {
              "properties": {
                "script": false
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "panels"
              ]
            },
            {
              "required": [
                "sidebar"
              ]
            },
            {
              "required": [
                "toolbar"
              ]
            },
            {
              "required": [
                "statusbar"
              ]
            },
            {
              "required": [
                "files"
              ]
            },
            {
              "required": [
                "background"
              ]
            }
          ]
        }
      }
    }
  ]
}
